---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | CineReseñas</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100">
    <header class="border-b border-zinc-800">
      <nav class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-4">
        <a href="/" class="text-lg font-bold text-amber-400">🎬 CineReseñas</a>
        <a href="/" class="hover:text-amber-400">Inicio</a>
        <a href="/acerca-de" class="hover:text-amber-400">Acerca de</a>
        <a href="/admin" class="hover:text-amber-400">Mis reseñas</a>
        <a href="/login" class="ml-auto hover:text-amber-400">Iniciar sesión</a>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
