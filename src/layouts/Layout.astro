---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.vue';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | CineReseñas</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100">
    <Nav />

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>

<script>
  import { supabase } from '../lib/supabase';
  import { navigate } from 'astro:transitions/client';

  // Se ejecuta en cada navegación (el menú se vuelve a pintar en cada página)
  document.addEventListener('astro:page-load', async () => {
    const link = document.querySelector<HTMLAnchorElement>('#nav-auth');
    if (!link) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return; // sin sesión se queda como "Iniciar sesión"

    link.textContent = 'Cerrar sesión';
    link.addEventListener('click', async (e) => {
      e.preventDefault();
      await supabase.auth.signOut();
      navigate('/');
    });
  });
</script>
