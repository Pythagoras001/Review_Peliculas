---
import Layout from '../layouts/Layout.astro';
import ListadoResenas from '../components/ListadoResenas.vue';
import { supabase } from '../lib/supabase';
import type { Resena } from '../lib/types';

// SSR: esta página se genera en el servidor en cada request (R1)
export const prerender = false;

const POR_PAGINA = 6;

// Leer los query params: /?q=texto&page=2
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const pageParam = Number(Astro.url.searchParams.get('page'));
const page = Number.isInteger(pageParam) && pageParam > 0 ? pageParam : 1;

// Rango de filas a pedir (Supabase cuenta desde 0)
const desde = (page - 1) * POR_PAGINA;
const hasta = desde + POR_PAGINA - 1;

let query = supabase.from('resenas').select('*', { count: 'exact' });

if (q) {
  query = query.ilike('titulo', `%${q}%`);
}

const { data, error: errorConsulta, count } = await query
  .order('id', { ascending: false })
  .range(desde, hasta);

// PGRST103 = página fuera de rango (ej. ?page=99): se trata como lista vacía
const error = errorConsulta?.code === 'PGRST103' ? null : errorConsulta;
const resenas = (data ?? []) as Resena[];
const totalPaginas = Math.max(1, Math.ceil((count ?? 0) / POR_PAGINA));
---

<Layout title="Inicio">
  <!-- Sin client:*: Vue renderiza la vista en el servidor (R3) -->
  <ListadoResenas
    resenas={resenas}
    q={q}
    page={page}
    totalPaginas={totalPaginas}
    total={count ?? 0}
    error={error?.message}
  />
</Layout>
