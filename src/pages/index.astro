---
import Layout from '../layouts/Layout.astro';
import ResenaCard from '../components/ResenaCard.vue';
import Paginacion from '../components/Paginacion.vue';
import { supabase } from '../lib/supabase';
import type { Resena } from '../lib/types';

// SSR: esta página se genera en el servidor en cada request (R1)
export const prerender = false;

const POR_PAGINA = 6;

// Leer los query params: /?q=texto&page=2
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const pageParam = Number(Astro.url.searchParams.get('page'));
const page = Number.isInteger(pageParam) && pageParam > 0 ? pageParam : 1;

// Rango de filas a pedir (Supabase cuenta desde 0)
const desde = (page - 1) * POR_PAGINA;
const hasta = desde + POR_PAGINA - 1;

let query = supabase.from('resenas').select('*', { count: 'exact' });

if (q) {
  query = query.ilike('titulo', `%${q}%`);
}

const { data, error: errorConsulta, count } = await query
  .order('id', { ascending: false })
  .range(desde, hasta);

// PGRST103 = página fuera de rango (ej. ?page=99): se trata como lista vacía
const error = errorConsulta?.code === 'PGRST103' ? null : errorConsulta;
const resenas = (data ?? []) as Resena[];
const totalPaginas = Math.max(1, Math.ceil((count ?? 0) / POR_PAGINA));
---

<Layout title="Inicio">
  <h1 class="mb-6 text-3xl font-bold">Reseñas de películas</h1>

  <form method="GET" action="/" class="mb-6 flex gap-2">
    <input
      type="search"
      name="q"
      value={q}
      placeholder="Buscar por título..."
      class="flex-1 rounded border border-zinc-700 bg-zinc-900 px-3 py-2"
    />
    <button class="rounded bg-amber-500 px-4 py-2 font-semibold text-zinc-950 hover:bg-amber-400">
      Buscar
    </button>
  </form>

  {q && (
    <p class="mb-4 text-sm text-zinc-400">
      {count ?? 0} resultado(s) para "{q}" · <a href="/" class="text-amber-400 underline">Limpiar</a>
    </p>
  )}

  {error && (
    <p class="rounded bg-red-900/50 p-4 text-red-200">
      Error al cargar las reseñas: {error.message}
    </p>
  )}

  {!error && resenas.length === 0 && (
    <p class="text-zinc-400">
      {q ? 'No se encontraron reseñas con ese título.' : 'No hay reseñas todavía.'}
    </p>
  )}

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {resenas.map((r) => <ResenaCard resena={r} />)}
  </ul>

  <Paginacion page={page} totalPaginas={totalPaginas} q={q} />
</Layout>
