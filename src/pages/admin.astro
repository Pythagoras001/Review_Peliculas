---
import Layout from '../layouts/Layout.astro';
import AdminPanel from '../components/AdminPanel.vue';

// SSG: el HTML (layout, menú, título) se genera en el build (R4).
// AdminPanel es una isla de Vue que solo corre en el navegador:
// verifica la sesión y hace el CRUD con Supabase desde el cliente (R5, R6)
export const prerender = true;
---

<Layout title="Mis reseñas">
  <AdminPanel client:only="vue">
    <p slot="fallback" class="text-zinc-400">Cargando panel...</p>
  </AdminPanel>
</Layout>
