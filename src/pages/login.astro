---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.vue';

// SSG: el HTML (layout, menú, título) se genera en el build (R4).
// LoginForm es una isla de Vue que usa Supabase Auth desde el navegador
export const prerender = true;
---

<Layout title="Iniciar sesión">
  <LoginForm client:only="vue">
    <p slot="fallback" class="text-zinc-400">Cargando...</p>
  </LoginForm>
</Layout>
