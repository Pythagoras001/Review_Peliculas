---
import Layout from '../layouts/Layout.astro';
import RegistroForm from '../components/RegistroForm.vue';

// SSG: el HTML (layout, menú, título) se genera en el build (R4).
// RegistroForm es una isla de Vue que usa Supabase Auth desde el navegador
export const prerender = true;
---

<Layout title="Registro">
  <RegistroForm client:only="vue">
    <p slot="fallback" class="text-zinc-400">Cargando...</p>
  </RegistroForm>
</Layout>
